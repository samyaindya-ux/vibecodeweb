# vibecodeweb .gitignore
# Simple static site — tracking everything including images (only 12MB).

# OS / editor noise
Thumbs.db
.DS_Store
*.swp
desktop.ini
__pycache__/
*.pyc

# Instagram automation — secrets & runtime artifacts (NEVER commit these)
ig-automation/config.php
tools_config.php
ig-automation/.htpasswd
ig-automation/logs/
ig-automation/*.token
ig-automation/token.json

# Deploy secret — never commit
deploy_secret.php

# Fare Finder: generated on the server by cron, and the token-bearing updater
farefinder/data.json
farefinder/update-fares.php
