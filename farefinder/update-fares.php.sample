<?php
/**
 * Fare Finder updater — PHP edition.
 *
 * For cPanel hosting with no SSH. Regenerates data.json from the Travelpayouts
 * API using nothing but PHP + curl, both standard on GlobeHost shared plans.
 *
 * Run it from cPanel -> Cron Jobs (no shell access needed):
 *
 *   /usr/local/bin/php /home/USERNAME/public_html/farefinder/update-fares.php
 *
 * Reads places.json for the airport list, so the route universe stays in step
 * with the Python engine rather than being duplicated here by hand.
 */

declare(strict_types=1);

// ---------------------------------------------------------------- settings
$CONFIG = [
    'token'          => getenv('FLIGHTWATCH_TOKEN') ?: 'PUT_YOUR_TOKEN_HERE',
    'base'           => getenv('FLIGHTWATCH_BASE') ?: 'https://api.travelpayouts.com',
    'origin'         => getenv('FLIGHTWATCH_ORIGIN') ?: 'CCU',
    'date_from'      => getenv('FLIGHTWATCH_FROM') ?: '2026-12-01',
    'date_to'        => getenv('FLIGHTWATCH_TO') ?: '2027-01-31',
    'roundtrip_days' => 0,      // >0 also fetches return legs, enabling round-trip search
    'currency'       => 'inr',
    'timeout'        => 25,     // seconds per request
    'pause_ms'       => 120,    // politeness delay between requests
    'max_failures'   => 40,     // abort rather than publish a mostly-empty file
    'dir'            => __DIR__,
];

// Web access is for eyeballing progress only, and must not be guessable.
// Set a secret and call update-fares.php?key=YOURSECRET
$WEB_KEY = '';

$cli = (PHP_SAPI === 'cli');
if (!$cli) {
    if ($WEB_KEY === '' || ($_GET['key'] ?? '') !== $WEB_KEY) {
        http_response_code(403);
        exit("Forbidden. Set \$WEB_KEY in update-fares.php and call it with ?key=...\n");
    }
    header('Content-Type: text/plain; charset=utf-8');
}
@set_time_limit(0);
ini_set('memory_limit', '512M');

function out(string $msg): void {
    echo '[' . gmdate('Y-m-d H:i:s') . "Z] $msg\n";
    if (PHP_SAPI !== 'cli') { @ob_flush(); @flush(); }
}
function fail(string $msg): never { out("ABORT: $msg"); exit(1); }

// ---------------------------------------------------------------- places
$placesPath = $CONFIG['dir'] . '/places.json';
if (!is_readable($placesPath)) fail("places.json not found next to this script.");
$places = json_decode((string)file_get_contents($placesPath), true);
if (!is_array($places) || !isset($places['places'])) fail("places.json is not valid.");

$origin = strtoupper($CONFIG['origin']);
if (!isset($places['places'][$origin])) fail("origin $origin is not in places.json");

/** Airports serving one city are never a sellable pair. */
function sameCity(array $places, string $a, string $b): bool {
    foreach ($places['sameCity'] ?? [] as $group) {
        if (in_array($a, $group, true) && in_array($b, $group, true)) return true;
    }
    return false;
}

$codes = array_keys($places['places']);
sort($codes);
$destinations = array_values(array_filter($codes, fn($c) => $c !== $origin && !sameCity($places, $origin, $c)));

// ---------------------------------------------------------------- months
function monthsBetween(string $from, string $to): array {
    $out = [];
    $cur = new DateTimeImmutable(substr($from, 0, 7) . '-01');
    $end = new DateTimeImmutable(substr($to, 0, 7) . '-01');
    while ($cur <= $end) { $out[] = $cur->format('Y-m'); $cur = $cur->modify('+1 month'); }
    return $out;
}
$months = monthsBetween($CONFIG['date_from'], $CONFIG['date_to']);
if ($CONFIG['roundtrip_days'] > 0) {
    $latest = (new DateTimeImmutable($CONFIG['date_to']))
        ->modify('+' . $CONFIG['roundtrip_days'] . ' days')->format('Y-m-d');
    $months = array_values(array_unique(array_merge($months, monthsBetween($CONFIG['date_from'], $latest))));
    sort($months);
}

// ---------------------------------------------------------------- fetching
function fetchLeg(array $cfg, string $from, string $to, string $month): array {
    $url = rtrim($cfg['base'], '/') . '/aviasales/v3/prices_for_dates?' . http_build_query([
        'origin' => $from, 'destination' => $to, 'departure_at' => $month,
        'one_way' => 'true', 'direct' => 'false', 'currency' => $cfg['currency'],
        'sorting' => 'price', 'limit' => 1000, 'page' => 1, 'token' => $cfg['token'],
    ]);
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => $cfg['timeout'],
        CURLOPT_FOLLOWLOCATION => false,
        CURLOPT_SSL_VERIFYPEER => true,
        CURLOPT_HTTPHEADER     => ['Accept: application/json', 'X-Access-Token: ' . $cfg['token']],
        CURLOPT_USERAGENT      => 'flightwatch-php/1.0',
    ]);
    $body = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err  = curl_error($ch);
    curl_close($ch);

    if ($body === false)       throw new RuntimeException("curl: $err");
    if ($code === 401 || $code === 403) throw new RuntimeException("token rejected (HTTP $code)");
    if ($code !== 200)         throw new RuntimeException("HTTP $code");
    $json = json_decode((string)$body, true);
    if (!is_array($json))      throw new RuntimeException('unparseable JSON');
    if (empty($json['success'])) throw new RuntimeException('api error: ' . ($json['error'] ?? '?'));
    return $json['data'] ?? [];
}

$codeIndex = array_flip($codes);
$airlines = [];
$offers   = [];
$failures = [];
$fetched  = 0;

$dayZero = new DateTimeImmutable($CONFIG['date_from']);
$legs = [];
foreach ($destinations as $dest) {
    $legs[] = [$origin, $dest];
    if ($CONFIG['roundtrip_days'] > 0) $legs[] = [$dest, $origin];
}
$total = count($legs) * count($months);
out("sweeping $total lookups: " . count($destinations) . " destinations x " . count($months) . ' months'
    . ($CONFIG['roundtrip_days'] > 0 ? ' x 2 directions' : ''));

if ($CONFIG['token'] === 'PUT_YOUR_TOKEN_HERE' || $CONFIG['token'] === '') {
    fail('no API token set. Edit $CONFIG[\'token\'] in this file.');
}

foreach ($legs as [$a, $b]) {
    foreach ($months as $month) {
        try {
            $rows = fetchLeg($CONFIG, $a, $b, $month);
        } catch (Throwable $e) {
            $failures[] = "$a-$b $month: " . $e->getMessage();
            if (str_contains($e->getMessage(), 'token rejected')) fail($e->getMessage());
            if (count($failures) > $CONFIG['max_failures']) {
                fail(count($failures) . ' lookups failed; refusing to publish a partial file.');
            }
            continue;
        }
        $fetched++;
        foreach ($rows as $row) {
            if (!isset($row['departure_at'], $row['price'])) continue;
            $day = substr((string)$row['departure_at'], 0, 10);
            if ($day < $CONFIG['date_from'] || $day > $CONFIG['date_to']) {
                if ($CONFIG['roundtrip_days'] <= 0) continue;
            }
            $off = (int)$dayZero->diff(new DateTimeImmutable($day))->format('%r%a');
            $air = (string)($row['airline'] ?? '');
            if ($air !== '' && !isset($airlines[$air])) $airlines[$air] = count($airlines);
            $offers[] = [
                $codeIndex[$a], $codeIndex[$b], $off, (int)round((float)$row['price']),
                $airlines[$air] ?? 0, (int)($row['transfers'] ?? 0),
            ];
        }
        if ($CONFIG['pause_ms'] > 0) usleep($CONFIG['pause_ms'] * 1000);
    }
}

if (!$offers) fail('provider returned no fares; keeping the previous data.json.');

out("fetched $fetched/$total lookups, " . count($offers) . ' offers'
    . ($failures ? ', ' . count($failures) . ' failed' : ''));
foreach (array_slice($failures, 0, 3) as $f) out("  ! $f");

// ---------------------------------------------------------------- write
$data = [
    'demo'        => false,
    'banner'      => '',
    'footer'      => '',
    'origin'      => $origin,
    'dateFrom'    => $CONFIG['date_from'],
    'dateTo'      => $CONFIG['date_to'],
    'codes'       => $codes,
    'places'      => $places['places'],
    'airlines'    => array_keys($airlines),
    'sameCity'    => $places['sameCity'] ?? [],
    'seasons'     => $places['seasons'] ?? [],
    'offers'      => $offers,
    'generatedAt' => gmdate('Y-m-d H:i') . ' UTC',
];

$tmp = $CONFIG['dir'] . '/data.json.tmp';
$dest = $CONFIG['dir'] . '/data.json';
if (file_put_contents($tmp, json_encode($data, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)) === false) {
    fail("could not write $tmp (check permissions)");
}
// Move into place only once the file is complete, so the site never serves a
// half-written data.json.
if (!rename($tmp, $dest)) { @unlink($tmp); fail("could not move $tmp -> $dest"); }
out('data.json updated (' . number_format(filesize($dest)) . ' bytes)');
